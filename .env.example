# sherpa-base settings (template, safe to commit: placeholders only).
#
# The REAL file lives on the persistent volume, outside git:
#   /media/volume/sherpa-data/_secrets/sherpa-base.env
# bootstrap.sh creates it from this template, generates POSTGRES_PASSWORD,
# and symlinks it to ./.env so plain `docker compose` also finds it.

# Where the persistent volume is mounted.
DATA_ROOT=/media/volume/sherpa-data

# Every Sherpa gets <name>.${BASE_DOMAIN}
BASE_DOMAIN=sherpa.ncsa.illinois.edu

# Let's Encrypt sends certificate-expiry warnings here. bootstrap.sh asks for it.
ACME_EMAIL=change-me@example.com

# Let's Encrypt directory URL.
#   Production (default): https://acme-v02.api.letsencrypt.org/directory
#   Staging (for testing, no rate limits): https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Superuser password for PostgreSQL. Generated by bootstrap.sh; only used when
# the data directory is first initialised, and by the admin scripts.
POSTGRES_PASSWORD=change-me

TZ=America/Chicago
